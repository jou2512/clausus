# Copy this file to .env and fill in your values. Never commit .env.
# Variable names follow the Hack Apertus project template.

# OpenAI-compatible endpoint serving Apertus 1.5.
# Hackathon inference endpoint shown below; for self-hosting point it at your own server.
LLM_BASE_URL=https://hackapertus.livemap.sh/v1

# Your API key for that endpoint.
LLM_API_KEY=

# Model used for understanding and detection.
LLM_NAME=apertus-v1.5-70b

# Optional: smaller model for the narrow person pass (default apertus-v1.5-8b).
# CLAUSUS_FAST_MODEL=apertus-v1.5-8b

# Optional: host port for Clausus (default 8080).
# CLAUSUS_PORT=8080

# Optional: shared key LiteLLM must send when it uses Clausus as a guardrail (docs/litellm.md).
# Empty means no check, only for a Clausus that is not reachable from outside.
# CLAUSUS_GUARDRAIL_KEY=

# Optional: transcription through any OpenAI-compatible endpoint (/audio/transcriptions) instead of
# the local hear container, e.g. your own Whisper server. Audio contains the originals, so every
# such call is listed in the receipt as original content leaving Clausus. Empty = local container.
# STT_BASE_URL=http://my-whisper:8000/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
